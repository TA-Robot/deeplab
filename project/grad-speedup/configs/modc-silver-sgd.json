{
  "run": {
    "output_root": "../runs/grad-speedup"
  },
  "dataset": {
    "name": "cifar10",
    "data_dir": "data",
    "val_size": 5000,
    "batch_size": 128,
    "num_workers": 4,
    "seed": 123,
    "download": false
  },
  "model": {
    "name": "resnet18"
  },
  "train": {
    "epochs": 5,
    "deterministic": false,
    "device": "cuda:0",
    "seeds": [
      0,
      1,
      2
    ]
  },
  "logging": {
    "log_interval_steps": 100,
    "eval_interval_epochs": 1,
    "warmup_steps": 50,
    "measure_steps": 200,
    "grad_norm_every": 0
  },
  "targets": [
    0.85,
    0.9,
    0.92,
    0.94
  ],
  "early_stop": "max",
  "modules": {
    "step_control": {
      "name": "silver",
      "silver_rho": 2.414213562373095
    },
    "direction": {
      "name": "none"
    },
    "clip": {
      "mode": "none"
    },
    "outer": {
      "name": "none"
    }
  },
  "optimizer": {
    "type": "sgd",
    "lr": 0.1,
    "momentum": 0.0,
    "weight_decay": 0.0005
  }
}